# Optional overrides for the seeded QA login credentials used by e2e/fixtures/auth.ts.
#
# The suite runs out-of-the-box without this file — working defaults are baked
# into the fixture and match the seeded logins documented in this repo's README.
# Copy this to `.env` only if you need to point the suite at a different seed
# dataset (e.g. a redeployed environment with different credentials).
SEED_ADMIN_EMAIL= abc@email.com
SEED_ADMIN_PASSWORD= xxxxxxxx
SEED_ACCOUNTANT_EMAIL= xyz@email.com
SEED_ACCOUNTANT_PASSWORD= xxxxxxxx